# DARKGPT CONFIGURATION - NO RESTRICTIONS
NODE_ENV=production
PORT=6666

# GROQ API - Get from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# DARK MODE SETTINGS
DARK_MODE=true
UNCENSORED=true
MAX_TOKENS=8192
TEMPERATURE=0.9
MODEL=mixtral-8x7b-32768

# SECURITY (DISABLED FOR MAXIMUM FREEDOM)
RATE_LIMIT=false
CONTENT_FILTER=false
ETHICAL_GUIDELINES=false

# DATABASE (OPTIONAL - FOR MALICIOUS HISTORY TRACKING)
REDIS_URL=redis://localhost:6379

# LOGGING (OPTIONAL - LOG ALL DARK ACTIVITIES)
LOG_LEVEL=debug
LOG_FILE=/var/log/darkgpt.log

# ADMIN ACCESS
ADMIN_TOKEN=supreme_dark_lord_token
ADMIN_IDS=666,777,888

# PROXY SETTINGS (FOR ANONYMITY)
USE_PROXY=true
PROXY_LIST=http://proxy1.com,http://proxy2.com,http://proxy3.com

# ENCRYPTION (OPTIONAL)
ENCRYPTION_KEY=darkgpt_super_secret_encryption_key_2024
